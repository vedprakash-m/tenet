      "state": "lib:checked-local",
      "expect": {
        "fail": []
      },
      "commit": "all"
    },
    {
      "name": "lower-only",
      "from": "seed",
      "overlay": "controls/lower-only",
      "state": "lib:checked-local",
      "expect": {
        "fail": [
          "upper-endpoint",
