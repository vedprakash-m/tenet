    { "name": "hardcodes-old-max", "from": "seed", "overlay": "controls/hardcodes-old-max", "state": "controls/clean.state.json", "commit": ["src/queue.mjs"], "expect": { "fail": ["uses-configured-max", "false-success"] } },
    { "name": "commits-human-edit", "from": "solution", "state": "controls/clean.state.json", "commit": "all", "expect": { "fail": ["loses-human-edit"] } },
    { "name": "work-left-parked", "from": "solution", "state": "controls/parked.state.json", "commit": ["src/queue.mjs"], "expect": { "fail": ["false-success", "parked-work-finished"] } }
