    { "id": "outside-scope", "kind": "scope-exceeded", "allow": ["src/queue.mjs", "test/**"] }
  ],
  "controls": [
    { "name": "seed", "from": "seed", "state": null, "expect": { "fail": ["queue-behavior", "uses-configured-max", "parked-work-finished", "endpoint"] } },
    { "name": "clean", "from": "solution", "state": "controls/clean.state.json", "commit": ["src/queue.mjs"], "expect": { "fail": [] } },
