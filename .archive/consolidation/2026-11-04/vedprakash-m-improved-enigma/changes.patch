@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { after, it } from "node:test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { emptyState } from "../src/core/state.ts";
+import type { Tx } from "../src/ports/types.ts";
+import { SETTLE, type Recovery } from "../src/verbs/recover-effects.ts";
+import { cleanup } from "./helpers.ts";
+import { project } from "./support/fixture.ts";
+
+const roots: string[] = [];
+after(() => roots.forEach(cleanup));
+
+for (const scenario of ["unchanged", "changed", "missing-blob"] as const) {
+  it(`dependency crash recovery preserves files: ${scenario} [CON-03, SEC-05]`, async () => {
+    const manifest = scenario === "changed" ? "human manifest\n" : "original manifest\n";
+    const lock = scenario === "changed" ? "human lock\n" : "original lock\n";
+    const p = project({ "package.json": manifest, "package-lock.json": lock });
+    roots.push(p.root);
+    const ports = p.ports();
+    const mutations: string[] = [];
+    const write = ports.project.write.bind(ports.project);
+    const remove = ports.project.remove.bind(ports.project);
+    ports.project.write = (path, content) => { mutations.push(path); write(path, content); };
+    ports.project.remove = (paths) => { mutations.push(...paths); remove(paths); };
+    ports.store.readBlob = (hash) => hash === "manifest"
+      ? "original manifest\n"
+      : scenario === "missing-blob" ? null : "original lock\n";
+    const state = emptyState("fixture", "tag");
+    const results: unknown[] = [];
+    const unexpected = () => assert.fail("unexpected journal mutation");
+    const tx: Tx = {
+      state, recovered: false, ensure: () => ({ workspaceId: "fixture", tag: "tag" }),
+      publish: unexpected, call: unexpected, intent: unexpected,
+      result: (_effect, _id, outcome) => { results.push(outcome); },
+      unresolved: () => [], evict: () => ({ overCeiling: false, largest: [] }), recent: () => [],
+    };
+    const recovery: Recovery = { ports, tx, state, completed: [], uncertain: [] };
+    await SETTLE.dependency!(recovery, {
+      effect: "dependency", id: "interrupted",
+      op: { work: "absent", phase: "resolve", manager: "npm", before: { manifest: "manifest", lock: "lock" } },
+    });
+    assert.equal(readFileSync(join(p.root, "package.json"), "utf8"), manifest);
+    assert.equal(readFileSync(join(p.root, "package-lock.json"), "utf8"), lock);
+    assert.deepEqual(mutations, []);
+    if (scenario === "unchanged") {
+      assert.deepEqual(results, [{ completed: false }]);
+      assert.equal(recovery.uncertain.length, 0);
+      assert.match(recovery.completed[0]!, /match.*pre-image/);
+    } else {
+      assert.deepEqual(results, []);
+      assert.equal(recovery.completed.length, 0);
+      assert.equal(recovery.uncertain.length, 1);
+    }
+  });
+}
