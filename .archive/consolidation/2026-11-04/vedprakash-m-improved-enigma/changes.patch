@@ -0,0 +1,78 @@
+import { after, describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { cleanup } from "./helpers.ts";
+import { project } from "./support/fixture.ts";
+import { restore } from "../src/decisions/dependency-job.ts";
+import { sha256 } from "../src/core/ids.ts";
+
+const roots: string[] = [];
+after(() => roots.forEach(cleanup));
+const read = (root: string, path: string): string => readFileSync(join(root, path), "utf8");
+
+describe("dependency restore ownership [SEC-05]", () => {
+  it("does not treat a post-resolution hash containing a human edit as resolver ownership", () => {
+    const p = project({ "package-lock.json": '{"lockfileVersion":3,"packages":{}}\n' });
+    roots.push(p.root);
+    const ports = p.ports();
+    const before = {
+      manifest: ports.store.putBlob(read(p.root, "package.json")),
+      lock: ports.store.putBlob(read(p.root, "package-lock.json")),
+    };
+    const humanManifest = '{"name":"fx","type":"module","private":true,"dependencies":{"a":"^1.0.0"},"human":"keep"}\n';
+    const humanLock = '{"lockfileVersion":3,"packages":{"node_modules/a":{"version":"1.0.0"}},"human":"keep"}\n';
+    p.write("package.json", humanManifest);
+    p.write("package-lock.json", humanLock);
+    const dep = {
+      specs: ["a@1.0.0"], urgent: false, quote: "add a", scripts: [], manager: "npm" as const,
+      before, after: { manifest: sha256(humanManifest), lock: sha256(humanLock) },
+    };
+    const writes: string[] = [];
+    ports.project.write = (path, content) => { writes.push(`${path}:${content}`); };
+    ports.project.remove = (paths) => { writes.push(...paths.map((path) => `remove:${path}`)); };
+
+    assert.equal(ports.project.hashes(["package.json", "package-lock.json"])["package.json"], dep.after.manifest);
+    restore(ports, dep);
+    assert.deepEqual(writes, [], "a post-resolution hash is not proof that the resolver owns these bytes");
+    assert.equal(read(p.root, "package.json"), humanManifest);
+    assert.equal(read(p.root, "package-lock.json"), humanLock);
+  });
+
+  it("does not overwrite a human edit made after the ownership hashes are checked", () => {
+    const p = project({ "package-lock.json": '{"lockfileVersion":3,"packages":{}}\n' });
+    roots.push(p.root);
+    const ports = p.ports();
+    const before = {
+      manifest: ports.store.putBlob(read(p.root, "package.json")),
+      lock: ports.store.putBlob(read(p.root, "package-lock.json")),
+    };
+    const resolvedManifest = '{"name":"fx","type":"module","private":true,"dependencies":{"a":"^1.0.0"}}\n';
+    const resolvedLock = '{"lockfileVersion":3,"packages":{"node_modules/a":{"version":"1.0.0"}}}\n';
+    p.write("package.json", resolvedManifest);
+    p.write("package-lock.json", resolvedLock);
+    const dep = {
+      specs: ["a@1.0.0"], urgent: false, quote: "add a", scripts: [], manager: "npm" as const,
+      before, after: { manifest: sha256(resolvedManifest), lock: sha256(resolvedLock) },
+    };
+    const originalHashes = ports.project.hashes.bind(ports.project);
+    let injected = false;
+    const writes: string[] = [];
+    ports.project.write = (path, content) => { writes.push(`${path}:${content}`); };
+    ports.project.remove = (paths) => { writes.push(...paths.map((path) => `remove:${path}`)); };
+    ports.project.hashes = (paths) => {
+      const observed = originalHashes(paths);
+      if (!injected && paths.includes("package.json") && paths.includes("package-lock.json")) {
+        injected = true;
+        p.write("package.json", '{"name":"fx","human":"arrived after comparison"}\n');
+        p.write("package-lock.json", '{"lockfileVersion":3,"human":"arrived after comparison"}\n');
+      }
+      return observed;
+    };
+
+    restore(ports, dep);
+    assert.deepEqual(writes, [], "hash-check followed by a separate write is not compare-and-swap");
+    assert.equal(read(p.root, "package.json"), '{"name":"fx","human":"arrived after comparison"}\n');
+    assert.equal(read(p.root, "package-lock.json"), '{"lockfileVersion":3,"human":"arrived after comparison"}\n');
+  });
+});
