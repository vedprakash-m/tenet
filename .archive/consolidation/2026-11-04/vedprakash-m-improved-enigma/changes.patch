+import assert from "node:assert/strict";
+import { after, it } from "node:test";
+import { readFileSync, rmSync, symlinkSync } from "node:fs";
+import { join } from "node:path";
+import { newContract } from "../src/core/state.ts";
+import { checkInputId, gather } from "../src/verbs/facts.ts";
+import { cleanup } from "./helpers.ts";
+import { project } from "./support/fixture.ts";
+
+const roots: string[] = [];
+after(() => roots.forEach(cleanup));
+
+it("invalidates gathered candidate and check identity after a hidden tracked deletion [EVD-03]", async () => {
+  const p = project(); roots.push(p.root);
+  const ports = p.ports(), probe = await ports.git.probe();
+  const start = { head: probe.head, branch: probe.branch, staged: [], dirty: [] };
+  const work = newContract({
+    id: "fixture", label: "W-0001", profile: "feature", request: "identity", lane: "quick", floor: "quick", level: "L0",
+    generation: 1, now: "2026-11-04T00:00:00Z", version: "fixture", assessment: {},
+    scopePaths: ["src/greet.ts"], protectedPaths: [], gitMode: "git", base: probe.head, branch: probe.branch, start,
+  });
+  const before = await gather(ports, work);
+  const identity = checkInputId(ports, work, before.candidate);
+  p.git("update-index", "--assume-unchanged", "src/greet.ts");
+  const index = readFileSync(join(p.root, ".git", "index"));
+  rmSync(join(p.root, "src", "greet.ts"));
+  const changed = await gather(ports, work);
+  assert.notEqual(changed.candidate, before.candidate);
+  assert.notEqual(checkInputId(ports, work, changed.candidate), identity);
+  assert.deepEqual(readFileSync(join(p.root, ".git", "index")), index);
+});
+
+it("refuses a hidden tracked path through a replaced parent symlink [SEC-06, EVD-03]", async () => {
+  const p = project(), outside = project(); roots.push(p.root, outside.root);
+  const ports = p.ports();
+  p.git("update-index", "--assume-unchanged", "src/greet.ts");
+  const index = readFileSync(join(p.root, ".git", "index"));
+  rmSync(join(p.root, "src"), { recursive: true });
+  symlinkSync(join(outside.root, "src"), join(p.root, "src"), process.platform === "win32" ? "junction" : "dir");
+  await assert.rejects(ports.git.inventory([]), /hidden tracked path/);
+  assert.deepEqual(readFileSync(join(p.root, ".git", "index")), index);
+  assert.ok(readFileSync(join(outside.root, "src", "greet.ts"), "utf8").length);
+});
