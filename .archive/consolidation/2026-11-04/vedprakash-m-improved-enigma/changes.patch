@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import { after, it } from "node:test";
+import { restoreFiles } from "../src/decisions/dependency-job.ts";
+import { cleanup } from "./helpers.ts";
+import { project } from "./support/fixture.ts";
+
+const roots: string[] = [];
+after(() => roots.forEach(cleanup));
+
+for (const missing of ["manifest", "lock"] as const) {
+  it(`validates the complete restore read set when ${missing} is missing [CON-03, SEC-05]`, () => {
+    const p = project(); roots.push(p.root);
+    const ports = p.ports(), mutations: string[] = [], reads: string[] = [];
+    ports.store.readBlob = (hash) => { reads.push(hash); return hash === missing ? null : "saved bytes"; };
+    ports.project.write = (path) => { mutations.push(path); };
+    ports.project.remove = (paths) => { mutations.push(...paths); };
+    assert.throws(() => restoreFiles(ports, { manifest: "manifest", lock: "lock" }), /pre-image/i);
+    assert.deepEqual(reads, ["manifest", "lock"]);
+    assert.deepEqual(mutations, []);
+  });
+}
+
+it("restores a valid empty blob and distinguishes prior absence [CON-03, SEC-05]", () => {
+  const p = project(); roots.push(p.root);
+  const ports = p.ports(), writes: Array<[string, string]> = [], removed: string[] = [];
+  ports.store.readBlob = (hash) => hash === "empty" ? "" : assert.fail("unexpected blob read");
+  ports.project.write = (path, content) => { writes.push([path, content]); };
+  ports.project.remove = (paths) => { removed.push(...paths); };
+  restoreFiles(ports, { manifest: "empty", lock: null });
+  assert.deepEqual(writes, [["package.json", ""]]);
+  assert.deepEqual(removed, ["package-lock.json"]);
+});
