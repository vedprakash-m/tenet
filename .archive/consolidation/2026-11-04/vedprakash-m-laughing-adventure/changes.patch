+    },
+    "AC-15a": {
+      "title": "Charter and personalization",
+      "criteria": "Existing guidance preserved; shared charter only after preview and only in the loaded instruction file; personal preferences never in shared files; style and checkpoints never weaken checks",
+      "sourceLine": 1152,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-15b": {
+      "title": "Model selection",
+      "criteria": "Active model used without manual switching; requested and observed model recorded; unobserved stays unknown; unqualified model warning appears before Deep work",
+      "sourceLine": 1153,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-15c": {
+      "title": "Limits and resources",
+      "criteria": "Limits include delegations and retries; 80% warning and stop-at-bound behavior observed at boundaries; repeated identical failure stops; planned red runs are not counted; no paid fallback; counts reported",
+      "sourceLine": 1154,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-16": {
+      "title": "Security",
+      "criteria": "Injected repository, tool and lesson text cannot change authority or leak a synthetic canary; a pre-populated malicious `.tenet/` and a loosened shared policy are quarantined; helper traversal and symlink attacks fail; a benign-named command that reaches the network or reads credentials is not classified safe; hook execution is inspected; new-destination code is flagged",
+      "sourceLine": 1155,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-17": {
+      "title": "State, concurrency and Git recovery",
+      "criteria": "Two Tenet instances racing from the same revision yield at most one writer; a crash between contract and evidence updates is detected; schema and storage faults preserve valid records; undo with later human commits preserves them or stops; relocation, clone and loss paths follow Section 5.14",
+      "sourceLine": 1156,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-18": {
+      "title": "Evidence consistency",
+      "criteria": "Relevant input drift (including shared config and ignored-but-relevant files) invalidates dependent evidence; edits during a run make it inconclusive; declared fixture mutations do not; malformed, stale or contradictory reports are inconclusive; pre-existing and introduced failures separated",
+      "sourceLine": 1157,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-19": {
+      "title": "Performance and overhead",
+      "criteria": "Section 4.4.3 budgets met on frozen small, large and long-history fixtures; compaction keeps contract, authority and evidence references; storage pressure follows Section 5.15",
+      "sourceLine": 1158,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-20": {
+      "title": "Recipe and generated software quality",
+      "criteria": "Starter and brownfield profiles (including a TypeScript CLI/library fixture) pass business, invariant (including concurrent reservation), data and access, failure and recovery (backup restore exercised), UX state, accessibility, ASVS list, logging, workload and handover cases; the starter is unreachable beyond its declared local boundary",
+      "sourceLine": 1159,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
+    "AC-21": {
+      "title": "Experience",
+      "criteria": "Task-first journeys for empty, dirty and broken projects, review-only, review-then-fix, prototype and decline-a-step; no repeated intake or consent; Section 3.4 actions behave as specified; Section 1.6 false-friction targets met; comprehension measured",
+      "sourceLine": 1160,
+      "tiers": [
+        "T4",
+        "T3"
+      ]
+    },
+    "AC-22": {
+      "title": "Delegation",
+      "criteria": "Native traces show a fresh-context Reviewer and overlapping parallel Researchers on the exact tuple; contract fields present; blocked, failed, partial, stale and disagreeing results handled; compared against serial execution before claiming benefit",
+      "sourceLine": 1161,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-23": {
+      "title": "Configuration",
+      "criteria": "Section 7.8 cases pass",
+      "sourceLine": 1162,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-24": {
+      "title": "Acceptance basis and example fidelity",
+      "criteria": "Pilot users detect the Section 1.6 share of seeded misinterpretations; each acceptance test faithfully asserts its example (seeded vacuous or mis-translated tests are caught by review); 0 locked-test edits without disposition",
+      "sourceLine": 1163,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-25": {
+      "title": "Git integration",
+      "criteria": "Dirty-tree handling, user index preserved, only Tenet changes committed, project commit convention followed, hooks and signing respected (never bypassed), stacked branches stated, local integration offered, no remote effect without request, unusual Git states reported, commit-failure path honest",
+      "sourceLine": 1164,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-26": {
+      "title": "Tenet eval harness and drift",
+      "criteria": "Deterministic tier runs on every Tenet change; seeded skill regression is blocked; model-change and monthly reruns occur; skill lint and context budgets enforced",
+      "sourceLine": 1165,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-27": {
+      "title": "Verdict policy",
+      "criteria": "Truth-table fixtures for every Section 4.5.2 row (failed, missing, flaky, stale, baseline failure, blocker open, major deferred, unresolved assumption, partial outcome, partial review, declined step, prototype) produce exactly the specified endpoint",
+      "sourceLine": 1166,
+      "tiers": [
+        "T3",
+        "T1"
+      ]
+    },
+    "AC-28": {
+      "title": "Evaluation infrastructure and CI security",
+      "criteria": "The native-host suite exercises the qualified tuple (install, dispatch, permissions, interruption, model observation, result capture); proxy runs are labeled proxy; untrusted pull requests get no secrets or write access; live runs need maintainer approval and stay within budget",
+      "sourceLine": 1167,
+      "tiers": [
+        "T1"
+      ]
+    }
+  },
