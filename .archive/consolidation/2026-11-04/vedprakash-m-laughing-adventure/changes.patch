+      ]
+    },
+    "AC-02": {
+      "title": "First-use usability (formative)",
+      "criteria": "≥ 4 of 5 unfamiliar technical builders reach an accurate next step within 10 min from the README; median first useful outcome ≤ 15 min on a ready fixture; blocked fixtures name the actual prerequisite",
+      "sourceLine": 1138,
+      "tiers": [
+        "T4",
+        "T3"
+      ]
+    },
+    "AC-03": {
+      "title": "Denial, missing capability and approval modes",
+      "criteria": "Denied actions do not run or get retried; affected work is blocked and labeled; unaffected read-only work continues; repeated setup preserves edits; under auto-approve, remote and destructive actions still get the chat gate",
+      "sourceLine": 1139,
+      "tiers": [
+        "T1",
+        "T3"
+      ]
+    },
