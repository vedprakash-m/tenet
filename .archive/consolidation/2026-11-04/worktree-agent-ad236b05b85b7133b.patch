+++ b/packages/kernel/src/core/fitness.ts
@@ -0,0 +1,217 @@
+// Workload fitness, pure slice (QLT-05; specs/workload-receipt.md §5.1, §5.4, §5.5). Candidate: nothing calls this yet, and the
+// spec is a draft. It parses a workload declaration, judges an untrusted workload report against the declared targets, keeps
+// a bounded per-function series, and applies the consecutive-degradation rule. The kernel judges against the declared targets;
+// the report's own verdict is not consulted. Pure: the caller supplies the report text, whether the command ran, the kernel's
+// environment tag and the receipt ids, so this reads no file and starts no process.
+import { z } from "zod";
+import { hashOf } from "./ids.ts";
+
+/** Every workload receipt and trend report says this (WR-7); a trend is not whole-application conformance. */
+export const WORKLOAD_LIMITATION =
+  "Measured on the declared reference workload on this machine. This is not evidence that the whole application meets its workload.";
+export const SERIES_MAX = 12;
+export const MAX_REPORT_BYTES = 10 * 1024 * 1024;
+export const MAX_REPORT_DEPTH = 64;
+
+const DOTTED = /^[A-Za-z_]\w*(\.[A-Za-z_]\w*)*$/;
+// TS §9.3: an argument array, no shell, no npx.
+const NO_RUNNER = new Set(["npx", "sh", "bash", "zsh", "dash", "cmd", "cmd.exe", "powershell", "pwsh"]);
+const Argv = z.array(z.string().min(1)).min(1);
+const safeReport = (p: string): boolean =>
+  p === "stdout" || (!/^([/\\]|[A-Za-z]:)/.test(p) && !p.includes("\0") && !p.split(/[/\\]/).includes(".."));
+
+const Fitness = z.strictObject({
+  id: z.string().regex(/^[a-z][a-z0-9-]{0,40}$/), measure: z.string().regex(DOTTED), unit: z.string().max(16),
+  better: z.enum(["lower", "higher"]), target: z.number(), trend: z.boolean().optional(),
+  degradation: z.strictObject({ percent: z.number().positive(), consecutive: z.number().int().min(2).max(SERIES_MAX) }).optional(),
+}).superRefine((f, ctx) => {
+  if (f.trend !== false && !f.degradation) {
+    ctx.addIssue({ code: "custom", path: ["degradation"], message: "a trending function declares its own threshold" });
+  }
+});
+
+export const Declaration = z.strictObject({
+  version: z.literal(1), build: Argv.optional(), run: Argv,
+  report: z.string().min(1).refine(safeReport, "a path under the run directory, or stdout"),
+  timeoutMs: z.number().int().positive(), minimumSamples: z.number().int().positive(),
+  samples: z.array(z.string().regex(DOTTED)).min(1).max(8), fitness: z.array(Fitness).min(1).max(32),
+}).superRefine((d, ctx) => {
+  const bad = (path: Array<string | number>) => ctx.addIssue({ code: "custom", path, message: "not allowed" });
+  for (const key of ["build", "run"] as const) {
+    const argv = d[key]?.[0];
+    if (argv !== undefined && (NO_RUNNER.has(argv) || (argv === "npm" && d[key]?.[1] === "exec"))) bad([key, 0]);
+  }
+  const seen = new Set<string>();
+  d.fitness.forEach((f, i) => { if (seen.has(f.id)) bad(["fitness", i, "id"]); seen.add(f.id); });
+});
+export type Declaration = z.infer<typeof Declaration>;
+export type FitnessFunction = Declaration["fitness"][number];
+
+/** The declaration, or the key that makes it invalid. A malformed declaration is never replaced by defaults (WR-1). */
+export function parseDeclaration(text: string): { ok: true; declaration: Declaration } | { ok: false; key: string } {
+  let json: unknown;
+  try { json = JSON.parse(text); } catch { return { ok: false, key: "workload.json" }; }
+  const r = Declaration.safeParse(json);
+  if (r.success) return { ok: true, declaration: r.data };
+  const issue = r.error.issues[0]!;
+  const path = issue.code === "unrecognized_keys" ? [...issue.path, issue.keys[0]!] : issue.path;
+  return { ok: false, key: path.map(String).join(".") || "workload.json" };
+}
+
+/** What a valid receipt keeps (spec §5.4): an environment tag, the sample count and one number per declared function. */
+export interface WorkloadMeasure { env: string; samples: number; measures: Record<string, number> }
+export interface Judgement {
+  status: "pass" | "fail" | "inconclusive";
+  /** Registry reason codes: `evidence-failed` for a miss, otherwise why the run could not be judged. */
+  reasons: string[];
+  failures: string[];
+  limitations: string[];
+  /** Present only for a pass or a fail. */
+  workload?: WorkloadMeasure;
+}
+
+const inconclusive = (reason: string, detail: string): Judgement =>
+  ({ status: "inconclusive", reasons: [reason], failures: [], limitations: [WORKLOAD_LIMITATION, detail] });
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+
+/** A number along a dotted path through own properties; anything else (absent, not finite, negative) is undefined. */
+function numberAt(root: unknown, path: string): number | undefined {
+  let at: unknown = root;
+  for (const key of path.split(".")) {
+    if (!isObject(at) || !Object.hasOwn(at, key)) return undefined;
+    at = at[key];
+  }
+  return typeof at === "number" && Number.isFinite(at) && at >= 0 ? at : undefined;
+}
+
+function tooDeep(root: unknown): boolean {
+  const pending: Array<[unknown, number]> = [[root, 0]];
+  while (pending.length) {
+    const [value, depth] = pending.pop()!;
+    if (depth > MAX_REPORT_DEPTH) return true;
+    if (value && typeof value === "object") for (const item of Object.values(value)) pending.push([item, depth + 1]);
+  }
+  return false;
+}
+
+/** The report as an object, or the reason it is not one (size, JSON, depth). */
+function parseReport(text: string): Record<string, unknown> | string {
+  if (Buffer.byteLength(text) > MAX_REPORT_BYTES) return "the report is larger than 10 MB";
+  let json: unknown;
+  try { json = JSON.parse(text); } catch { return "the report is not JSON"; }
+  if (tooDeep(json)) return `the report is nested deeper than ${MAX_REPORT_DEPTH}`;
+  return isObject(json) ? json : "the report is not an object";
+}
+
+/**
+ * A tag for the machine, from what the kernel observed through its ports (node major, platform, architecture, memory), never from
+ * the project's report (review W2). Only the tag is kept.
+ */
+export const environmentTag = (seen: { node: string; platform: string; arch: string; totalMemoryBytes: number }): string => {
+  const node = Number(/^v?(\d+)\./.exec(seen.node)?.[1] ?? NaN);
+  return hashOf({ node, platform: seen.platform, arch: seen.arch, totalMemoryBytes: seen.totalMemoryBytes });
+};
+
+const missed = (f: FitnessFunction, v: number): boolean => (f.better === "lower" ? v > f.target : v < f.target);
+
+/** Measures and sample count, or the inconclusive result explaining which declared path the report lacks. */
+function readReport(decl: Declaration, report: Record<string, unknown>, env: string): WorkloadMeasure | Judgement {
+  const counts = decl.samples.map((p) => numberAt(report, p));
+  const lacking = decl.samples.filter((_, i) => counts[i] === undefined);
+  const measures: Record<string, number> = {};
+  for (const f of decl.fitness) {
+    const v = numberAt(report, f.measure);
+    if (v === undefined) lacking.push(f.measure); else measures[f.id] = v;
+  }
+  if (lacking.length) return inconclusive("report-invalid", `the report lacks a finite number at ${lacking.join(", ")}`);
+  return { env, samples: (counts as number[]).reduce((a, b) => a + b, 0), measures };
+}
+
+/**
+ * The kernel's judgement of one workload run against the declared targets (WR-3, WR-4). `exit` is absent when the command did not
+ * run; `env` is the kernel's own `environmentTag`. The report's own verdict (`referencePass`, `reasons`) and the exit status are not
+ * consulted: the draft's `report-contradiction` rule is not implemented (review W3, open question).
+ */
+export function judgeWorkload(decl: Declaration, run: { exit?: number; text?: string; env: string }): Judgement {
+  if (run.exit === undefined) return inconclusive("not-executed", "the workload command did not run");
+  if (run.text === undefined) return inconclusive("report-missing", "the workload produced no report");
+  const report = parseReport(run.text);
+  if (typeof report === "string") return inconclusive("report-invalid", report);
+  if (report.mode === "smoke") return inconclusive("population-mismatch", "a smoke run is a diagnostic and never passes");
+  if (report.mode !== "reference") return inconclusive("report-invalid", "the report does not state mode reference");
+  const read = readReport(decl, report, run.env);
+  if ("status" in read) return read;
+  if (read.samples < decl.minimumSamples) {
+    return inconclusive("population-mismatch", `the report has fewer than the minimum of ${decl.minimumSamples} samples`);
+  }
+  const failures = decl.fitness.flatMap((f) => {
+    const v = read.measures[f.id]!;
+    return missed(f, v) ? [`${f.id}: ${v} ${f.unit} against a target of ${f.target} (${f.better} is better)`] : [];
+  });
+  const reasons = failures.length ? ["evidence-failed"] : [];
+  return { status: failures.length ? "fail" : "pass", reasons, failures, limitations: [WORKLOAD_LIMITATION], workload: read };
+}
+
+/** One measurement of one function, from one kernel-run receipt (WR-5, WR-8). */
+export interface Point { value: number; receipt: string; at: string; env: string }
+/** At most 12 points, newest last. `raised` is the first receipt of the last window that raised an item (spec §5.5). */
+export interface Series { points: Point[]; raised?: string }
+
+/** Keyed by receipt id: a point for a receipt already in the series changes nothing, so a replayed `finish` adds none (review W7). */
+export function appendPoint(series: Series | undefined, p: Point): Series {
+  const points = series?.points ?? [];
+  return { ...series, points: points.some((q) => q.receipt === p.receipt) ? [...points] : [...points, p].slice(-SERIES_MAX) };
+}
+export function markRaised(series: Series | undefined, firstReceipt: string): Series {
+  return { points: [...(series?.points ?? [])], raised: firstReceipt };
+}
+
+/** One point for each function that trends; an invariant (`trend: false`) can fail a receipt but never enters a series. */
+export function pointsOf(decl: Declaration, w: WorkloadMeasure, receipt: string, at: string): Record<string, Point> {
+  const trending = decl.fitness.filter((f) => f.trend !== false);
+  return Object.fromEntries(trending.map((f) => [f.id, { value: w.measures[f.id]!, receipt, at, env: w.env }]));
+}
+
+/** The same window keeps the same attention item id, so a disposition survives a recheck (spec §5.6). */
+export const attentionId = (fitnessId: string, firstReceipt: string): string =>
+  `AT-${hashOf({ fitness: fitnessId, first: firstReceipt }).slice(0, 8)}`;
+
+export interface Degradation { id: string; first: Point; last: Point; window: Point[]; changePercent: number }
+
+/**
+ * The window rule of spec §5.5 (recommended reading, owner question Q1 option A). Over the points with the latest environment,
+ * the last n points never improve and the last is worse than the first by more than p percent. It fires on the first receipt
+ * of the window as the reference, so no baseline is stored, and a window must start after the one already raised.
+ */
+export function degradation(f: FitnessFunction, series: Series): Degradation | null {
+  const rule = f.degradation;
+  const latest = series.points.at(-1);
+  if (!rule || f.trend === false || !latest) return null;
+  const points = series.points.filter((p) => p.env === latest.env);
+  const n = rule.consecutive, start = points.length - n;
+  if (start < 0 || start <= points.findIndex((p) => p.receipt === series.raised)) return null;
+  const window = points.slice(start);
+  const sign = f.better === "lower" ? 1 : -1; // worse is up when lower is better, down when higher is better
+  if (window.some((p, i) => i > 0 && sign * (p.value - window[i - 1]!.value) < 0)) return null;
+  const first = window[0]!, last = window[n - 1]!;
+  // A zero first point has no percent change; the draft leaves it undefined (review W5), so it never fires.
+  if (first.value === 0 || !(sign * (last.value - first.value) * 100 > rule.percent * first.value)) return null;
+  const changePercent = (sign * (last.value - first.value) * 100) / first.value;
+  return { id: attentionId(f.id, first.receipt), first, last, window, changePercent };
+}
+
+const round = (n: number): number => Math.round(n * 100) / 100;
+
+/** What `inspect` and `finish` would show (spec §5.5, E14): the retained points, the change from the first, and what this does not show. */
+export function trendReport(decl: Declaration, series: Record<string, Series>): string[] {
+  const lines = decl.fitness.flatMap((f) => {
+    const points = f.trend === false ? [] : series[f.id]?.points ?? [];
+    if (!points.length) return [];
+    const values = points.map((p) => p.value);
+    if (values.length === 1) return [`${f.id}: ${values[0]} ${f.unit} (1 point)`];
+    const first = values[0]!, last = values.at(-1)!;
+    const change = first === 0 ? "n/a" : `${last >= first ? "+" : ""}${round(((last - first) * 100) / first)}%`;
+    return [`${f.id}: ${values.join(", ")} ${f.unit} (change ${change} from the first retained point)`];
+  });
+  return [...lines, WORKLOAD_LIMITATION];
+}
