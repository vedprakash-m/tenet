+  it("gives the same item id for the same window and a different one for another function or window", () => {
+    assert.equal(attentionId("a", "R1"), attentionId("a", "R1"));
+    assert.notEqual(attentionId("a", "R1"), attentionId("b", "R1"));
+    assert.notEqual(attentionId("a", "R1"), attentionId("a", "R2"));
+    assert.match(attentionId("a", "R1"), /^AT-[a-f0-9]{8}$/);
+  });
+  it("never fires from a zero first point, which has no percent change (review W5, open question)", () => {
+    assert.equal(degradation(fn(), series([0, 0, 1])), null);
+    assert.equal(degradation(fn(), series([0, 0, 0])), null);
+    assert.equal(degradation(fn({ better: "higher" }), series([0, 0, 1])), null);
+  });
+  it("fires on a step after a flat run, as the rule is written (review W5: it is not only a slow-decline detector)", () => {
+    assert.ok(degradation(fn(), series([100, 100, 121])));
+  });
+  it("property: fewer than n points in one environment never fire", () => {
+    fc.assert(fc.property(fc.array(fc.integer({ min: 0, max: 1000 }), { maxLength: 2 }), (values) => {
+      assert.equal(degradation(fn(), series(values)), null);
+    }));
+  });
+  it("property: a window that improves anywhere does not fire", () => {
+    fc.assert(fc.property(fc.array(fc.integer({ min: 1, max: 1000 }), { minLength: 3, maxLength: 12 }), (values) => {
+      const window = values.slice(-3);
+      const improves = window[1]! < window[0]! || window[2]! < window[1]!;
+      if (improves) assert.equal(degradation(fn(), series(values)), null);
+    }));
+  });
+  it("property: it fires exactly when the window never improves and the rise is more than the percent", () => {
+    fc.assert(fc.property(fc.array(fc.integer({ min: 0, max: 1000 }), { minLength: 3, maxLength: 12 }), fc.integer({ min: 1, max: 90 }), (values, percent) => {
+      const [a, b, c] = values.slice(-3) as [number, number, number];
+      const expected = b >= a && c >= b && (c - a) * 100 > percent * a;
+      assert.equal(degradation(fn({ degradation: { percent, consecutive: 3 } }), series(values)) !== null, expected);
+    }));
+  });
+  it("property: scaling every value by a positive integer changes nothing", () => {
+    fc.assert(fc.property(fc.array(fc.integer({ min: 0, max: 1000 }), { maxLength: 12 }), fc.integer({ min: 1, max: 50 }), (values, k) => {
+      assert.equal(degradation(fn(), series(values.map((v) => v * k))) !== null, degradation(fn(), series(values)) !== null);
+    }));
+  });
+  it("property: points of another environment placed before the series change nothing (E9)", () => {
+    fc.assert(fc.property(fc.array(fc.integer({ min: 0, max: 1000 }), { minLength: 1, maxLength: 8 }), fc.array(fc.integer({ min: 0, max: 5000 }), { maxLength: 8 }), (values, other) => {
+      const base = series(values);
+      const prefixed: Series = { points: [...series(other, "env-z", 100).points, ...base.points] };
+      assert.equal(degradation(fn(), prefixed) !== null, degradation(fn(), base) !== null);
+    }));
+  });
+});
+
+describe("trend report (WR-7, E14)", () => {
+  const d = declare();
+  it("lists the retained points and the change from the first, and says what is not shown", () => {
+    const text = trendReport(d, { "list-p95-ms": series([100, 110, 121]) }).join("\n");
+    assert.match(text, /list-p95-ms: 100, 110, 121 ms/);
+    assert.match(text, /\+21%/);
+    assert.ok(text.includes(WORKLOAD_LIMITATION));
+  });
+  it("makes no claim that the application meets its workload", () => {
+    const text = trendReport(d, { "list-p95-ms": series([100, 90, 80]), "peak-rss-bytes": series([1, 1, 1]) }).join("\n").replace(WORKLOAD_LIMITATION, "");
+    assert.doesNotMatch(text, /meets|conform|passes|within target/i);
+  });
+  it("shows the series with its sign for an improvement, one point plainly, and nothing for an invariant", () => {
+    const text = trendReport(d, { "list-p95-ms": series([100, 80]), "peak-rss-bytes": series([5]), "duplicate-items": series([0, 0]) }).join("\n");
+    assert.match(text, /-20%/);
+    assert.match(text, /peak-rss-bytes: 5 bytes \(1 point\)/);
+    assert.doesNotMatch(text, /duplicate-items/);
+  });
+  it("shows the unit-less change as not available when the first point is zero", () => {
+    assert.match(trendReport(d, { "list-p95-ms": series([0, 3]) }).join("\n"), /change n\/a/);
+  });
+  it("still carries the limitation when there is no series yet", () => {
+    assert.deepEqual(trendReport(d, {}), [WORKLOAD_LIMITATION]);
+  });
+});
