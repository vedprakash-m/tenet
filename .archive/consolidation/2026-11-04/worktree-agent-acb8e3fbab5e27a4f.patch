diff --git a/packages/kernel/src/core/trace.ts b/packages/kernel/src/core/trace.ts
new file mode 100644
index 0000000..44a70bf
--- /dev/null
+++ b/packages/kernel/src/core/trace.ts
@@ -0,0 +1,93 @@
+// ENG-09 trace (candidate, specs/eng-09-trace-candidate.md, PROPOSED): a read-time view of one work's recorded facts.
+// Pure and never stored. A value the kernel did not record is "unknown"; one that has no meaning for the event is "not-applicable".
+import type { LogEntry } from "../ports/types.ts";
+import type { ModelRecord, WorkContract } from "./schemas.ts";
+
+type Missing = "unknown" | "not-applicable";
+type Termination = "completed" | "cancelled" | "timeout" | "crashed" | Missing;
+
+export interface TraceEvent {
+  work: string; seq: number; ref: string; at: string; endedAt?: string; durationMs?: number;
+  role: "coordinator" | "reviewer" | "analyst"; action: string; model: ModelRecord | "unknown";
+  intentRevision: number | Missing; permission: "approved" | "unknown";
+  check: Receipt["status"] | "not-applicable"; outcome?: string; termination: Termination;
+}
+export interface Trace {
+  work: string; label: string; state: string; intentRevision: number | Missing; termination: Termination;
+  denied: string[]; gaps: Array<{ code: string; text: string }>; events: TraceEvent[];
+}
+type Receipt = WorkContract["receipts"][number];
+export type TraceWork = Pick<
+  WorkContract,
+  "id" | "label" | "state" | "createdAt" | "model" | "basis" | "grants" | "declined" | "receipts" | "reviews" | "analyses"
+>;
+
+const GAPS = {
+  "host-actions-not-recorded": "Host tool actions, host approvals and subagent activity are not observed; only kernel records appear.",
+  "calls-not-attributed": "Journal call records name no work, so they are not part of this trace.",
+  "permission-per-event-unrecorded": "Grants record no decision time and no covered action, so a per-event permission cannot be derived.",
+  "intent-revision-per-event-unrecorded": "Events record no basis revision; the revision shown on the trace is the current one.",
+  "event-time-unrecorded": "Review and analysis records carry no time.",
+  "model-unrecorded": "The model was not reported or observed for some events.",
+  "earlier-journal-missing": "Journal records older than the first one kept are gone; earlier effects may be missing.",
+} as const;
+const ENDED: Partial<Record<WorkContract["state"], Termination>> = {
+  finished: "completed", cancelled: "cancelled", superseded: "cancelled",
+};
+const checkEnd = (r: Receipt): Termination =>
+  r.status === "skipped" ? "not-applicable" : r.reasons.includes("timeout") ? "timeout" : r.signal ? "crashed"
+    : r.exit !== undefined ? "completed" : "unknown";
+const dispatchEnd = (status: string): Termination => (status === "completed" || status === "cancelled" ? status : "unknown");
+const byTime = (a: { at: string }, b: { at: string }): number =>
+  a.at === b.at ? 0 : a.at === "unknown" ? 1 : b.at === "unknown" ? -1 : a.at < b.at ? -1 : 1;
+
+export function traceOf(w: TraceWork, log: readonly LogEntry[]): Trace {
+  const { basis } = w;
+  const revisionOf = (basisHash?: string): number | Missing =>
+    !basis ? "not-applicable" : basisHash !== undefined && basisHash === basis.hash ? basis.intentRevision : "unknown";
+  const draft = (d: Pick<TraceEvent, "ref" | "role" | "action"> & Partial<TraceEvent>): Omit<TraceEvent, "seq"> => ({
+    work: w.label, at: "unknown", model: w.model ?? "unknown", intentRevision: revisionOf(), permission: "unknown",
+    check: "not-applicable", termination: "unknown", ...d,
+  });
+  const done = new Map(log.filter((e) => e.kind === "result").map((e) => [`${e.effect}\0${e.id}`, e]));
+  const effects = log.filter((e) => e.kind === "intent" && (e.op as { work?: unknown } | null)?.work === w.id).map((e) => {
+    const end = done.get(`${e.effect}\0${e.id}`);
+    const ok = (end?.outcome as { completed?: unknown } | null | undefined)?.completed;
+    return draft({
+      ref: e.id!, role: "coordinator", action: e.effect!, at: e.t, ...(end ? { endedAt: end.t } : {}),
+      outcome: !end ? "unresolved" : ok === true ? "completed" : ok === false ? "not-completed" : "unknown",
+      termination: end ? "completed" : "unknown",
+    });
+  });
+  const all = [
+    draft({ ref: w.id, role: "coordinator", action: "open", at: w.createdAt, intentRevision: "not-applicable", termination: "completed",
+      permission: w.grants.some((g) => g.source === "request") ? "approved" : "unknown" }),
+    ...w.receipts.map((r) => draft({
+      ref: r.id, role: "coordinator", action: "check", at: r.provenance.startedAt, check: r.status,
+      durationMs: r.durationMs, termination: checkEnd(r),
+    })),
+    ...w.reviews.map((l) => draft({
+      ref: l.reservation, role: "reviewer", action: "review", model: l.model ?? "unknown",
+      intentRevision: revisionOf(l.basisHash), outcome: l.status, termination: dispatchEnd(l.status),
+    })),
+    ...w.analyses.map((a) => draft({
+      ref: a.reservation, role: "analyst", action: "analysis", model: a.model ?? "unknown",
+      outcome: a.status, termination: dispatchEnd(a.status),
+    })),
+    ...effects,
+  ].sort(byTime);
+  const found: Record<keyof typeof GAPS, boolean> = {
+    "host-actions-not-recorded": true, "calls-not-attributed": true,
+    "permission-per-event-unrecorded": all.some((e) => e.permission === "unknown"),
+    "intent-revision-per-event-unrecorded": !!basis && all.some((e) => e.intentRevision === "unknown"),
+    "event-time-unrecorded": all.some((e) => e.at === "unknown"),
+    "model-unrecorded": all.some((e) => e.model === "unknown" || e.model.source === "unknown"),
+    "earlier-journal-missing": !!log[0] && log[0].t > w.createdAt,
+  };
+  return {
+    work: w.id, label: w.label, state: w.state, intentRevision: basis?.intentRevision ?? "not-applicable",
+    termination: ENDED[w.state] ?? "not-applicable", denied: [...w.declined],
+    gaps: Object.entries(GAPS).filter(([code]) => found[code as keyof typeof GAPS]).map(([code, text]) => ({ code, text })),
+    events: all.map((e, i) => ({ ...e, seq: i + 1 })),
+  };
+}
