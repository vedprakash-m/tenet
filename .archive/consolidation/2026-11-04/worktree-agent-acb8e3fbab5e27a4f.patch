diff --git a/packages/kernel/test/trace.test.ts b/packages/kernel/test/trace.test.ts
new file mode 100644
index 0000000..a34dcd2
--- /dev/null
+++ b/packages/kernel/test/trace.test.ts
@@ -0,0 +1,203 @@
+// ENG-09 trace candidate (specs/eng-09-trace-candidate.md, PROPOSED): a read-time view derived from the contract and the
+// journal. Pure tests: nothing here starts a mutating verb, so they run on any host.
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { traceOf } from "../src/core/trace.ts";
+import type { TraceWork } from "../src/core/trace.ts";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { cleanup } from "./helpers.ts";
+import { project } from "./support/fixture.ts";
+import { emptyState } from "../src/core/state.ts";
+import { formatHandle } from "../src/core/ids.ts";
+import { render } from "../src/pipeline-render.ts";
+import { inspect } from "../src/verbs/inspect.ts";
+import type { Receipt, ReviewLink, AnalystLink, WorkContract } from "../src/core/schemas.ts";
+import type { LogEntry, Ports } from "../src/ports/types.ts";
+
+const T0 = "2026-11-01T10:00:00.000Z";
+const at = (min: number) => `2026-11-01T10:${String(min).padStart(2, "0")}:00.000Z`;
+const model = { requested: "gpt-x", source: "reported", qualification: "unknown" } as const;
+const BASIS = { intentRevision: 3, elementIds: [], hash: "bh", traits: [] };
+
+const work = (o: Partial<TraceWork> = {}): TraceWork => ({
+  id: "w1", label: "W-0001", state: "executing", createdAt: T0, grants: [], declined: [],
+  receipts: [], reviews: [], analyses: [], ...o,
+});
+const receipt = (o: Partial<Receipt> & { id: string }): Receipt =>
+  ({ status: "pass", reasons: [], durationMs: 5, exit: 0, provenance: { runId: "r", runDir: "d", startedAt: at(5) }, ...o }) as unknown as Receipt;
+const review = (o: Partial<ReviewLink>): ReviewLink => ({ reservation: "RV-1", status: "completed", basisHash: "bh", ...o }) as unknown as ReviewLink;
+const analyst = (o: Partial<AnalystLink>): AnalystLink => ({ reservation: "AN-1", status: "completed", role: "security", ...o }) as unknown as AnalystLink;
+const intent = (effect: string, id: string, min: number, op: unknown = { work: "w1" }): LogEntry => ({ t: at(min), kind: "intent", effect, id, op });
+const result = (effect: string, id: string, min: number, outcome: unknown): LogEntry => ({ t: at(min), kind: "result", effect, id, outcome });
+const codes = (t: ReturnType<typeof traceOf>) => t.gaps.map((g) => g.code);
+
+const FIELDS = ["work", "ref", "at", "role", "action", "model", "intentRevision", "permission", "check", "termination"];
+
+describe("trace derivation [ENG-09]", () => {
+  it("[ENG-09] gives every event the named fields, in time order with unrecorded times last", () => {
+    const w = work({
+      basis: BASIS, model, grants: [{ id: "g1", source: "request" }] as never,
+      receipts: [receipt({ id: "RC-1" })],
+      reviews: [review({ model: { ...model, requested: "gpt-r" } })], analyses: [analyst({})],
+    });
+    const log = [intent("commit", "c1", 10), result("commit", "c1", 11, { completed: true, commit: "abc" })];
+    const t = traceOf(w, log);
+    assert.deepEqual(t.events.map((e) => [e.seq, e.action, e.role, e.at]), [
+      [1, "open", "coordinator", T0], [2, "check", "coordinator", at(5)], [3, "commit", "coordinator", at(10)],
+      [4, "review", "reviewer", "unknown"], [5, "analysis", "analyst", "unknown"],
+    ]);
+    for (const e of t.events) for (const f of FIELDS) assert.ok(Object.hasOwn(e, f), `${e.action} lacks ${f}`);
+    const [open, check, commit, rev, ana] = t.events;
+    assert.deepEqual([open!.intentRevision, open!.permission, open!.model], ["not-applicable", "approved", model]);
+    assert.deepEqual([check!.check, check!.termination, check!.durationMs, check!.ref], ["pass", "completed", 5, "RC-1"]);
+    assert.deepEqual([commit!.endedAt, commit!.outcome, commit!.termination], [at(11), "completed", "completed"]);
+    assert.deepEqual([rev!.model, rev!.intentRevision, rev!.outcome], [{ ...model, requested: "gpt-r" }, 3, "completed"]);
+    assert.deepEqual([ana!.model, ana!.check, ana!.permission], ["unknown", "not-applicable", "unknown"]);
+    assert.equal(t.work, "w1");
+    assert.equal(t.intentRevision, 3);
+  });
+
+  it("[ENG-09] shows a missing model as unknown and a stored unknown model unchanged, and declares the gap for both", () => {
+    const none = traceOf(work(), []);
+    assert.equal(none.events[0]!.model, "unknown");
+    assert.ok(codes(none).includes("model-unrecorded"));
+    const stored = { requested: "inherited", source: "unknown", qualification: "unknown" } as const;
+    const kept = traceOf(work({ model: stored }), []);
+    assert.deepEqual(kept.events[0]!.model, stored);
+    assert.ok(codes(kept).includes("model-unrecorded"));
+    assert.ok(!codes(traceOf(work({ model }), [])).includes("model-unrecorded"));
+  });
+
+  it("[ENG-09] reports the check outcome and how each check ended", () => {
+    const t = traceOf(work({
+      receipts: [
+        receipt({ id: "a", status: "inconclusive", reasons: ["timeout"], signal: "SIGKILL", exit: undefined }),
+        receipt({ id: "b", status: "inconclusive", reasons: ["not-executed"], signal: "SIGSEGV", exit: undefined }),
+        receipt({ id: "c", status: "fail", exit: 1 }),
+        receipt({ id: "d", status: "skipped", exit: undefined, reasons: ["not-executed"] }),
+        receipt({ id: "e", status: "inconclusive", exit: undefined, reasons: ["not-executed"] }),
+      ],
+    }), []);
+    assert.deepEqual(t.events.slice(1).map((e) => [e.ref, e.check, e.termination]), [
+      ["a", "inconclusive", "timeout"], ["b", "inconclusive", "crashed"], ["c", "fail", "completed"],
+      ["d", "skipped", "not-applicable"], ["e", "inconclusive", "unknown"],
+    ]);
+  });
+
+  it("[ENG-09] says an effect with no result is unresolved with an unknown ending, and never calls it a crash", () => {
+    const t = traceOf(work(), [
+      intent("commit", "c1", 1),
+      intent("integration", "i1", 2), result("integration", "i1", 3, { completed: false }),
+      intent("index-sync", "s1", 4), result("index-sync", "s1", 5, { status: "synced" }),
+    ]);
+    assert.deepEqual(t.events.slice(1).map((e) => [e.action, e.outcome, e.termination, e.endedAt]), [
+      ["commit", "unresolved", "unknown", undefined],
+      ["integration", "not-completed", "completed", at(3)],
+      ["index-sync", "unknown", "completed", at(5)],
+    ]);
+  });
+
+  it("[ENG-09] maps the contract's state to a termination, and says not-applicable while the work has not ended", () => {
+    const of = (state: TraceWork["state"]) => traceOf(work({ state }), []).termination;
+    assert.deepEqual(
+      (["finished", "cancelled", "superseded", "executing", "parked", "blocked"] as const).map(of),
+      ["completed", "cancelled", "cancelled", "not-applicable", "not-applicable", "not-applicable"],
+    );
+  });
+
+  it("[ENG-09] links the intent revision only where a record ties the event to the basis", () => {
+    const hashed = [review({ reservation: "RV-1", basisHash: "bh" }), review({ reservation: "RV-2", basisHash: "old" })];
+    const none = traceOf(work({ reviews: hashed, receipts: [receipt({ id: "r1" })] }), []);
+    assert.deepEqual(none.events.map((e) => e.intentRevision), ["not-applicable", "not-applicable", "not-applicable", "not-applicable"]);
+    assert.equal(none.intentRevision, "not-applicable");
+    assert.ok(!codes(none).includes("intent-revision-per-event-unrecorded"));
+    const withBasis = traceOf(work({ basis: BASIS, reviews: hashed, receipts: [receipt({ id: "r1" })] }), []);
+    assert.deepEqual(withBasis.events.map((e) => e.intentRevision), ["not-applicable", "unknown", 3, "unknown"]);
+    assert.ok(codes(withBasis).includes("intent-revision-per-event-unrecorded"));
+  });
+
+  it("[ENG-09] records permission only from a request grant at open, and lists declined steps apart", () => {
+    assert.equal(traceOf(work(), []).events[0]!.permission, "unknown");
+    assert.equal(traceOf(work({ grants: [{ id: "g", source: "decide" }] as never }), []).events[0]!.permission, "unknown");
+    const t = traceOf(work({ grants: [{ id: "g", source: "request" }] as never, declined: ["review"], receipts: [receipt({ id: "r" })] }), []);
+    assert.deepEqual(t.events.map((e) => e.permission), ["approved", "unknown"]);
+    assert.deepEqual(t.denied, ["review"]);
+    assert.ok(codes(t).includes("permission-per-event-unrecorded"));
+  });
+
+  it("[ENG-09] declares the visibility gaps it can see, and only those", () => {
+    const quiet = traceOf(work({ model, grants: [{ id: "g", source: "request" }] as never }), []);
+    assert.deepEqual(codes(quiet), ["host-actions-not-recorded", "calls-not-attributed"]);
+    const timeless = traceOf(work({ model, reviews: [review({ model })] }), []);
+    assert.ok(codes(timeless).includes("event-time-unrecorded"));
+    const late = traceOf(work({ model }), [{ t: at(30), kind: "call", verb: "open", exit: 0 }]);
+    assert.ok(codes(late).includes("earlier-journal-missing"));
+    const early = traceOf(work({ model }), [{ t: at(0), kind: "call", verb: "open", exit: 0 }]);
+    assert.ok(!codes(early).includes("earlier-journal-missing"));
+    for (const g of quiet.gaps) assert.ok(g.text.length > 0 && !/[{}]/.test(g.text));
+  });
+});
+
+describe("trace boundaries", () => {
+  it("leaves out other works' effects, call records and effects that name no work", () => {
+    const t = traceOf(work(), [
+      { t: at(1), kind: "call", verb: "commit", exit: 0, revision: 4 },
+      intent("commit", "x1", 2, { work: "other" }),
+      intent("adopt", "x2", 3, { files: ["INTENT.md"] }),
+      intent("forget", "x3", 4, null),
+      intent("commit", "mine", 5),
+    ]);
+    assert.deepEqual(t.events.map((e) => e.ref), ["w1", "mine"]);
+  });
+
+  it("is a pure function of its inputs", () => {
+    const w = work({ basis: BASIS, model, receipts: [receipt({ id: "r1" })], reviews: [review({})] });
+    const log = [intent("commit", "c1", 10)];
+    const frozen = structuredClone({ w, log });
+    const first = traceOf(w, log);
+    assert.deepEqual(traceOf(w, log), first);
+    assert.deepEqual({ w, log }, frozen);
+  });
+
+  it("is served by inspect --view trace from the work and the journal, without writing", async () => {
+    const state = emptyState("ws", "ab12");
+    const w = { ...work({ basis: BASIS, model }), session: { generation: 1 } } as unknown as WorkContract;
+    state.work[w.id] = w;
+    const log = [intent("commit", "c1", 10)];
+    const ports = { store: { readLog: () => log } } as unknown as Ports;
+    const before = JSON.stringify(state);
+    const plan = await inspect.run(ports, state, { view: "trace", h: formatHandle(1, 1, "ab12") });
+    const data = plan.resp.data as { trace: ReturnType<typeof traceOf> };
+    assert.deepEqual(data.trace, traceOf(w, log));
+    assert.equal(JSON.stringify(state), before);
+    assert.equal(inspect.class({ view: "trace" } as never), "read-only");
+  });
+
+  it("returns nothing that redaction would remove: a token-shaped model name is redacted in the response", () => {
+    const token = `ghp_${"a1B2c3D4".repeat(5)}`;
+    const t = traceOf(work({ model: { requested: token, source: "reported", qualification: "unknown" } }), []);
+    const res = render({ version: "t" } as Ports, "inspect", { data: { trace: t } }, null);
+    assert.ok(!JSON.stringify(res).includes(token));
+    assert.ok(JSON.stringify(res).includes("[redacted]"));
+  });
+});
+
+// Needs the real kernel, which refuses mutating verbs on Windows; unverified there, run by POSIX CI.
+describe("trace on a real project", { skip: process.platform === "win32" }, () => {
+  it("[ENG-09] shows the opened work's named fields and leaves the state and journal bytes unchanged", async () => {
+    const p = project();
+    try {
+      const h = (await p.call("open", { profile: "investigate", request: "how are greetings tested?", model: "gpt-x" })).handle!;
+      const files = () => ["state", "log"].map((f) => readFileSync(join(p.root, ".tenet", f), "utf8"));
+      const before = files();
+      const r = await p.call("inspect", { view: "trace", h });
+      const trace = (r.data as { trace: ReturnType<typeof traceOf> }).trace;
+      assert.equal(r.exit, 0, JSON.stringify(r));
+      assert.deepEqual(trace.events.map((e) => e.action), ["open"]);
+      assert.equal((trace.events[0]!.model as { requested: string }).requested, "gpt-x");
+      for (const f of FIELDS) assert.ok(Object.hasOwn(trace.events[0]!, f), f);
+      assert.deepEqual(files(), before);
+    } finally { cleanup(p.root); }
+  });
+});
diff --git a/specs/eng-09-trace-candidate.md b/specs/eng-09-trace-candidate.md
new file mode 100644
index 0000000..e96023e
--- /dev/null
+++ b/specs/eng-09-trace-candidate.md
@@ -0,0 +1,159 @@
+# ENG-09 trace: smallest contract (candidate)
+
+**Status: PROPOSED. Not reviewed, not approved.** Implemented only as an isolated candidate on a worktree branch, by the owner's temporary exception to sign-off-before-implementation. Nothing here amends the canonical specs. If the owner rejects it, delete the candidate.
+
+Closes nothing in plan §12.3 until the owner records a disposition for each choice in §4.
+
+## 1. Requirement
+
+PRD ENG-09 (Must, Release B, AC-13a): trace events shall link intent revision, work, role, observed model, action, permission outcome, check outcome, timestamps and termination state, and shall declare visibility gaps.
+
+Plan §12.3 (2026-10-31) records six undecided points: event placement, correlation semantics, missing-value vocabulary, action/permission/check taxonomy, termination mapping, and the retention/export boundary.
+
+## 2. What exists today (read from the code, not assumed)
+
+| Fact | Where | Consequence |
+|---|---|---|
+| Journal `call` records hold only `t`, `verb`, `exit`, `revision`. | `pipeline-render.ts#stamp`, `store-fs.ts` | A call cannot be tied to a work, role or model. |
+| Journal `intent`/`result` records hold `t`, `effect`, `id`; most `op` values carry `work`. | `tx.intent` callers | Commits, integrations, undo, branch, dependency, forget and index-sync can be tied to a work and dated. |
+| Receipts hold id, stage, `status`, `exit`, `signal`, `reasons`, `provenance.startedAt`, `durationMs`. | `core/schemas.ts#Receipt` | Check events with outcome, start time and how the run ended. |
+| `ReviewLink` and `AnalystLink` hold reservation, status, `model`; no timestamp. | `core/schemas.ts` | Role and model are known; time is not. |
+| The contract holds `model`, `basis.intentRevision`, `basis.hash`, `grants`, `declined`, `state`, `createdAt`. | `WorkContract` | Work, coordinator model, current intent revision, termination. |
+| Grants carry no decision time and no link to the action they covered. | `Grant` | Per-event permission outcome is not derivable. |
+| `inspect` has no `export` view. `InspectInput.view` lacks it and the default branch refuses unknown views. Tech Spec §6.5 and §7.1 describe `export` as a previewed, saved-to-path bundle that is not built. | `verbs/inspect.ts`, `core/schemas.ts` | "Render through the existing export path" has no path to use. See choice C6. |
+| Tech Spec §16 sketches a `CallRecord` with `role`, `model`, `permission`, `checkOutcome`, `termination`, `visibilityGaps`. No code writes these fields. | `specs/tech-spec.md` §16 | Writing them is a new persisted shape; this candidate does not. |
+
+## 3. Contract
+
+### 3.1 Shape
+
+The trace is a **derived, read-only view of one work**. It is computed on demand by a pure function from the work contract and the journal, and is never stored.
+
+```ts
+type Missing = "unknown" | "not-applicable";
+type TraceEvent = {
+  work: string;                 // the contract label, e.g. "W-0001"
+  seq: number;                  // 1-based position after ordering
+  ref: string;                  // id of the record the event came from: work id, receipt id, reservation id or effect id
+  at: string;                   // ISO time from that record, or "unknown"
+  endedAt?: string;             // effects only, from the result record
+  durationMs?: number;          // checks only, from the receipt
+  role: "coordinator" | "reviewer" | "analyst";
+  action: "open" | "check" | "review" | "analysis" | EffectName;   // EffectName: the journal's effect string, as recorded
+  model: ModelRecord | "unknown";   // the record exactly as stored; "unknown" only when none is stored
+  intentRevision: number | Missing;
+  permission: "approved" | "unknown";
+  check: "pass" | "fail" | "inconclusive" | "skipped" | "not-applicable";
+  outcome?: string;             // review/analysis status, or effect "completed" | "not-completed" | "unresolved"
+  termination: "completed" | "cancelled" | "timeout" | "crashed" | Missing;
+};
+type Trace = {
+  work: string; label: string; state: string;
+  intentRevision: number | Missing;
+  termination: TraceEvent["termination"];
+  denied: string[];             // steps the user declined (contract.declined)
+  gaps: { code: string; text: string }[];
+  events: TraceEvent[];
+};
+```
+
+Strings are ids, closed values and the stored model record. No file contents, prompts, request text, command output or secrets enter the trace. The inspect response is redacted by the pipeline's existing `redactDeep` (SEC-11) like every other response.
+
+### 3.2 Event sources
+
+| Event | Source | role | at |
+|---|---|---|---|
+| `open` | contract | coordinator | `createdAt` |
+| `check` | each receipt | coordinator | `provenance.startedAt` |
+| `review` | each `ReviewLink` | reviewer | `unknown` |
+| `analysis` | each `AnalystLink` | analyst | `unknown` |
+| effect name | journal intent (+ result) whose `op.work` is this work's id | coordinator | intent `t` |
+
+Ordering: known times ascending; ties and unknown times keep source order (open, checks, reviews, analyses, effects), unknown last. `seq` is assigned after ordering.
+
+## 4. Choices for the six undecided points
+
+| # | Point | Choice | Why smallest | Alternative rejected |
+|---|---|---|---|---|
+| C1 | Event placement | No new stream. The trace is derived per work from the contract and journal at read time. | No schema change, no new retention, no write path, no migration. | Extend `call` records with the §16 fields: persisted semantics, and the pipeline would have to know role, model and permission at every call (new pipeline logic). Separate trace file: a second source of truth that can disagree with the state. |
+| C2 | Correlation | One work per trace. Events carry the contract label and `ref`, the id of the record they came from. Effects pair by `(effect, id)`; a pair is attributed to a work only when `op.work` is that work's id. Call records are excluded because they name no work. | Uses ids that already exist. | A global correlation id or trace id (OpenTelemetry style): needs minting and storing at `open`. A join of calls to work by `revision`: state history is not kept, so the join would guess. |
+| C3 | Missing values | Two words. `unknown`: the kernel holds no record though the fact may exist. `not-applicable`: the field has no meaning for this event, or the thing it names cannot exist yet. A stored `unknown` (for example a model record with `source: "unknown"`) stays exactly as stored. | Matches Tech Spec §16 (`"unknown"`) and the existing ModelRecord rule; adds one word. | `null` or omitted fields: indistinguishable from a bug. A `not-yet` word: not needed once `not-applicable` covers "before a basis exists". |
+| C4 | Taxonomy | `role`: the three in Tech Spec §16. `action`: `open`, `check`, `review`, `analysis`, or the journal's own effect name; no renaming layer. `permission`: `approved` or `unknown` per event; `denied` is reported separately as the trace-level `denied` list. `check`: the receipt `status` for checks, else `not-applicable`. | Reuses strings the kernel already owns. | A new action taxonomy mapping effects to ActionClass: the mapping is a policy choice and still cannot say when a grant applied. Emitting `auto-approved`: nothing observes host approvals. |
+| C5 | Termination | Event level: a receipt with reason `timeout` is `timeout`; a receipt with a `signal` is `crashed`; a receipt with an `exit` is `completed` (a failing test still ended normally; its result is in `check`); `skipped` is `not-applicable`. An effect with a result record is `completed` (its success is in `outcome`); an effect with no result record is `unknown`, because the journal alone cannot tell a run still in flight from one that died. Review/analysis: status `completed` is `completed`, `cancelled` is `cancelled`, any other status is `unknown`. `open` is `completed`. Trace level: `finished` is `completed`; `cancelled` and `superseded` are `cancelled`; every other state is `not-applicable` (the work has not ended). | Each rule reads one stored field. | Declaring `crashed` for an effect with no result: would be a claim without liveness evidence (TS §7.3: elapsed time never decides liveness). Mapping `host-limit` to `timeout`: a usage limit is not a timeout. |
+| C6 | Retention and export boundary | Retention equals that of the facts it reads: the contract (state document) and the journal under the existing compaction (TS §5.15 subset). Nothing is written. The view is `inspect --view trace --h <handle>`, a new value of the existing `InspectInput.view`. When `inspect export` is built, the trace is one more section of its previewed bundle, and field-name mapping to the OpenTelemetry GenAI subset (ENG-06, Should, R1) happens there. This candidate does neither. | The export bundle has its own open design (preview, chosen path, consent). Tying ENG-09 to it would block ENG-09 on that work. | Implementing `inspect export` now: a larger unreviewed surface (path handling, preview). Mapping to OpenTelemetry now: ENG-06 is a separate, later requirement. |
+
+## 5. Visibility gaps
+
+`gaps` is derived from the same facts and is never empty-by-omission. Codes are fixed; the text is a fixed string, never built from data.
+
+| Code | Declared when | Text |
+|---|---|---|
+| `host-actions-not-recorded` | always | Host tool actions, host approvals and subagent activity are not observed; only kernel records appear. |
+| `calls-not-attributed` | always | Journal call records name no work, so they are not part of this trace. |
+| `permission-per-event-unrecorded` | any event has `permission: unknown` | Grants record no decision time and no covered action, so a per-event permission cannot be derived. |
+| `intent-revision-per-event-unrecorded` | the work has a basis and any event has `intentRevision: unknown` | Events record no basis revision; the revision shown on the trace is the current one. |
+| `event-time-unrecorded` | any event has `at: unknown` | Review and analysis records carry no time. |
+| `model-unrecorded` | any event has `model: "unknown"` or a model record whose source is `unknown` | The model was not reported or observed for some events. |
+| `earlier-journal-missing` | the journal's first record is later than the contract's `createdAt` | Journal records older than the first one kept are gone; earlier effects may be missing. |
+
+Per-event `permission` and `intentRevision`:
+
+- `open`: `permission` is `approved` when a grant with `source: "request"` exists (WRK-02: the clear request itself authorizes routine local work), else `unknown`. `intentRevision` is `not-applicable` (no basis exists at open).
+- Every other event: `permission` is `unknown`.
+- With no basis, every event's `intentRevision` is `not-applicable`. With a basis, a review whose `basisHash` equals the basis hash carries `basis.intentRevision`; every other non-`open` event is `unknown`.
+
+## 6. Behavior as examples
+
+Test file for all: `packages/kernel/test/trace.test.ts`.
+
+| # | Given | Then |
+|---|---|---|
+| E1 | A work with a basis, one passing receipt, one reviewer link, one analyst link, one committed effect in the journal | Events are `open`, `check`, `commit` in time order, then `review`, `analysis` with `at: unknown`; each has all ten named fields. |
+| E2 | A work with no model record | `model` is `"unknown"` and `model-unrecorded` is declared; a stored `{source: "unknown"}` record is returned unchanged and also declares the gap. |
+| E3 | Receipts: timed out, killed by signal, normal fail, skipped | `termination` is `timeout`, `crashed`, `completed`, `not-applicable`; `check` is the receipt status. |
+| E4 | An effect intent with no result | `termination: unknown`, `outcome: unresolved`. With `{completed: false}` it is `termination: completed`, `outcome: not-completed`; with `{status: ...}` it is `termination: completed`, `outcome: unknown`. |
+| E5 | `finished`, `cancelled`, `superseded`, `executing` contracts | Trace termination `completed`, `cancelled`, `cancelled`, `not-applicable`. |
+| E6 | A journal effect for another work, a call record, and an effect with no `op.work` | None appears. |
+| E7 | A review whose `basisHash` matches, and one that does not | The first carries the basis revision; the second is `unknown`. |
+| E8 | Contract with `declined: ["review"]` | `denied: ["review"]`. |
+| E9 | A model `requested` containing a token-shaped string, rendered through the pipeline's redaction | The token does not appear in the response. |
+| E10 | `inspect --view trace --h <handle>` on a real project (needs POSIX; the kernel refuses mutating verbs on Windows); the same view is also tested with stub ports | The response carries the trace; the state document and journal are byte-identical before and after. |
+
+## 7. State and contract changes
+
+- State document: none. Journal: none. Receipts: none. Schema version: unchanged.
+- CLI input contract: `InspectInput.view` gains the value `trace` (an input enum, not stored).
+- New pure module `core/trace.ts`; `verbs/inspect.ts` gains one case and one line in its help table.
+- Plugin text (skills, agents, commands): unchanged. The view is not advertised to the model, so `lint-skills` has nothing to check.
+
+## 8. Risks
+
+1. **Many `unknown` values.** Permission and per-event intent revision are mostly `unknown` today. That is the truthful reading of the current facts, but it means AC-13a ("every contract links to intent IDs") is met at the contract level only, not per event. Closing it needs a stamped basis revision on receipts and a decision time on grants (a schema change).
+2. **Journal compaction.** Older effect pairs are summarised into counts (TS §5.15 subset), so old works lose their effect events. `earlier-journal-missing` declares this only when the first kept record is later than `createdAt`; it cannot see a gap in the middle.
+3. **Effect attribution depends on `op.work`.** Effects whose `op` lacks it (adopt, hardening, scaffold) are in no work trace and no gap says so, because they are project-level, not work-level. Test E6 fixes this behavior; the owner may prefer a gap code for them.
+4. **Read of a live journal.** The read takes no lock. A torn last line is already ignored by the journal reader; a record appended during the read may be missing. The response is not claimed to be newer than its inputs.
+5. **Termination of review/analysis.** `partial`, `blocked` and `failed` map to `unknown`, not `crashed`. A reader who wants those will find them in `outcome`.
+6. **The ENG-09 sentence "observed model".** The kernel stores `source: reported | observed | unknown`; today only `reported` and `unknown` occur. The trace shows the record unchanged, so it never upgrades a reported model to an observed one.
+
+## 9. Assumptions
+
+- A receipt with `signal` set and no `timedOut` reason means the run was killed, which the candidate calls `crashed`. This follows `core/receipts.ts` ("it did not execute, timed out, was killed"). Unverified on a real host.
+- `open` completing is implied by the contract existing.
+- Only effect results of the shape `{completed: boolean}` give `outcome` `completed` or `not-completed`; a result without it (index-sync's `{status}`) gives `outcome: unknown` and still `termination: completed`, since a result record exists.
+- A receipt that is not skipped and has no `timeout` reason, no `signal` and no `exit` has `termination: unknown`.
+
+## 10. Acceptance criteria
+
+1. Every ENG-09 field named in §1 appears on every event, with an explicit value from §3.1; none is omitted or invented.
+2. No persisted shape changes; `git diff` shows no change to `core/schemas.ts` beyond the `InspectInput` enum value.
+3. The trace for the same inputs is identical on every call (pure derivation).
+4. E1 to E9 pass locally as pure tests; E10 passes on POSIX CI.
+5. `npm run typecheck` and the three lints pass.
+
+## 11. Decisions the owner must make
+
+1. Accept or change each of C1 to C6.
+2. Accept `inspect --view trace` as the interim surface, or hold ENG-09 until `inspect export` is designed.
+3. Accept contract-level-only intent linking for now, or approve the schema change that stamps basis revision on receipts and effects and a decision time on grants.
+4. Confirm that `denied` may stay a trace-level list rather than a per-event value.
+5. Whether to backfill Tech Spec §16 (it describes persisted `CallRecord` fields this candidate does not write) and record a disposition in plan §12.3.
