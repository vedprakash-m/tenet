{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["server", "shared"]
}
