{
  "name": "@vedprakash-m/tenet",
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedprakash-m/tenet.git"
  },
  "homepage": "https://github.com/vedprakash-m/tenet#readme",
  "bugs": {
    "url": "https://github.com/vedprakash-m/tenet/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tenet": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/sdk.js"
  },
  "files": [
    "dist",
    "kit",
    "pkg/conformance/alg-02",
    "pkg/conformance/alg-03",
    "pkg/conformance/alg-04",
    "pkg/conformance/alg-08",
    "pkg/conformance/alg-09",
    "pkg/conformance/alg-10",
    "pkg/conformance/alg-11",
    "pkg/conformance/alg-14",
    "pkg/conformance/board",
    "pkg/conformance/card",
    "pkg/conformance/check",
    "pkg/conformance/install",
    "pkg/conformance/scenarios"
  ],
  "workspaces": [
    ".",
    "runner"
  ],
  "scripts": {
    "build": "tsc --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --verbatimModuleSyntax --noEmitOnError --skipLibCheck --outDir dist --rootDir src --declaration --sourceMap src/cli.ts src/sdk.ts && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "gen:types": "node src/core/schema.ts --generate-types",
    "lint": "biome lint .",
    "prepack": "npm run build",
    "test": "npm run build && node scripts/run-tests.mjs",
    "coverage": "npm run build && node scripts/run-tests.mjs --coverage",
    "health:snapshot": "node scripts/health-snapshot.mjs",
    "scenarios": "npm test -- test/onboard/scenarios.test.ts",
    "eval:onboarding": "node pkg/evals/onboarding/run.mjs",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.2",
    "fast-xml-parser": "^5.2.5",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
