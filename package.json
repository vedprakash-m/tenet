{
  "name": "tenet-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint-arch.ts && node tools/lint-skills.ts && node tools/lint-quality.ts",
    "coverage": "node tools/coverage.ts --milestone M0",
    "build": "node tools/build.ts",
    "test": "node --test --test-concurrency=4 \"packages/**/test/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run lint && npm run coverage && npm run build && npm test",
    "privacy": "node tools/privacy-check.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
