{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedprakash-m.github.io/tenet/schemas/0.1/pack.json",
  "title": "Tenet lifecycle pack",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "pack": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "loop_backs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loopBack"
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_touches": {
      "$ref": "#/$defs/humanTouches"
    },
    "work_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules_alpha0": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "pack",
    "version",
    "description",
    "phases",
    "stations",
    "loop_backs",
    "lanes",
    "human_touches",
    "work_types",
    "rules_alpha0"
  ],
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "phase"
      ]
    },
    "loopBack": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "humanTouches": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "express": {
          "type": "integer",
          "minimum": 0
        },
        "quick": {
          "type": "integer",
          "minimum": 0
        },
        "careful": {
          "type": "integer",
          "minimum": 0
        },
        "deep": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "express",
        "quick",
        "careful",
        "deep"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observe": {
          "$ref": "#/$defs/ruleMode"
        },
        "protect": {
          "$ref": "#/$defs/ruleMode"
        },
        "verify": {
          "$ref": "#/$defs/ruleMode"
        },
        "assure": {
          "$ref": "#/$defs/ruleMode"
        }
      },
      "required": [
        "id",
        "observe",
        "protect",
        "verify",
        "assure"
      ]
    },
    "ruleMode": {
      "enum": [
        "advise",
        "enforce"
      ]
    }
  }
}
