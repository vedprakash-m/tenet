{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenet.dev/schemas/agent/0.json",
  "title": "Tenet agent definition front matter",
  "description": "Draft 0.1. Standard §14.3. The seven body sections of the fixed anatomy are checked by `tenet agent check`, not by this schema. An overlay sets `extends` and only narrowing fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
    "extends": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z][a-z0-9-]+@[\\^~]?\\d+(\\.\\d+){0,2}$"},
    "role": {"type": "string"},
    "kind": {"enum": ["creator", "critic", "verifier", "coordinator", "steward"]},
    "status": {"enum": ["draft", "candidate", "qualified", "active", "probation", "deprecated", "retired"]},
    "sponsor": {"type": "string"},
    "description": {"type": "string", "maxLength": 300},
    "stations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lanes": {"type": "array", "minItems": 1, "items": {"enum": ["quick", "standard", "deep"]}},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": {"type": "string"},
        "allowed": {"type": "array", "items": {"type": "string"}},
        "effort": {"enum": ["low", "medium", "high"]}
      }
    },
    "tools": {"type": "array", "items": {"type": "string"}, "description": "Allowlist; everything else is denied"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {"type": "array", "items": {"type": "string"}},
        "deny_read": {"type": "array", "items": {"type": "string"}},
        "deny_write": {"type": "array", "items": {"type": "string"}}
      }
    },
    "network": {"anyOf": [{"const": "none"}, {"type": "array", "items": {"type": "string"}}]},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {"type": "integer", "minimum": 1},
        "tool_calls": {"type": "integer", "minimum": 1},
        "wall_minutes": {"type": "integer", "minimum": 1},
        "tokens": {"type": "integer", "minimum": 1}
      }
    },
    "output_schema": {"type": "string"},
    "criteria": {"type": "array", "items": {"type": "string"}},
    "handoff": {"type": "array", "items": {"type": "string"}},
    "eval_suite": {"type": ["string", "null"]},
    "qualified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "host", "suite", "date", "result"],
        "properties": {
          "model": {"type": "string"},
          "host": {"type": "string"},
          "suite": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "result": {"type": "string"}
        }
      }
    }
  },
  "if": {"required": ["extends"]},
  "then": {"not": {"anyOf": [{"required": ["id"]}, {"required": ["kind"]}, {"required": ["role"]}]}},
  "else": {
    "required": ["id", "version", "role", "kind", "status", "sponsor", "stations", "lanes", "tools", "paths", "network", "budget", "output_schema"],
    "allOf": [
      {"if": {"properties": {"kind": {"const": "critic"}}, "required": ["kind"]}, "then": {"properties": {"paths": {"properties": {"write": {"maxItems": 0}}}}}}
    ]
  }
}
