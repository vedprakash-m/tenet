{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedprakash-m.github.io/tenet/schemas/0.1/agent-card.json",
  "title": "Tenet agent card front matter",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "creator",
        "critic"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "spec_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "spec_levels",
        "sections",
        "artifacts"
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "result_schema": {
          "type": "string",
          "minLength": 1
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "result_schema"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "filesystem",
        "git",
        "network"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "write",
        "deny_read",
        "deny_write"
      ]
    },
    "acts_as": {
      "type": [
        "string",
        "null"
      ]
    },
    "sponsor": {
      "type": [
        "string",
        "null"
      ]
    },
    "stop_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eval_suite": {
      "type": [
        "string",
        "null"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {}
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "distinct_from": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "distinct_from"
      ]
    },
    "finding_schema": {
      "type": "string",
      "minLength": 1
    },
    "abstain_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "version",
    "role",
    "kind",
    "purpose",
    "inputs",
    "outputs"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "creator"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "type": "object",
            "properties": {
              "writes": {}
            },
            "required": [
              "writes"
            ]
          },
          "criteria": false,
          "independence": false,
          "finding_schema": false,
          "abstain_when": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "critic"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "criteria": {},
          "independence": {},
          "finding_schema": {},
          "abstain_when": {}
        },
        "required": [
          "criteria",
          "independence",
          "finding_schema",
          "abstain_when"
        ]
      }
    }
  ]
}
