{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedprakash-m.github.io/tenet/schemas/0.1/results/fix.json",
  "title": "Fix result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "action"
        ]
      }
    }
  },
  "required": [
    "changes"
  ]
}
