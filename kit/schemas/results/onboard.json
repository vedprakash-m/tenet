{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedprakash-m.github.io/tenet/schemas/0.1/results/onboard.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "read_count": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_count": {
              "type": "integer",
              "minimum": 0
            },
            "dirty_warning": {
              "type": "boolean"
            }
          },
          "required": [
            "revision",
            "read_count",
            "skipped_count",
            "dirty_warning"
          ]
        },
        "inventory": {
          "$ref": "../inventory.json"
        },
        "findings": {
          "$ref": "../inventory.json#/properties/findings"
        },
        "assignment": {
          "$ref": "../assignment.json"
        }
      },
      "required": [
        "preflight",
        "inventory",
        "findings",
        "assignment"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "string",
          "minLength": 1
        },
        "drafted_at_rev": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{6,64}$"
        }
      },
      "required": [
        "card",
        "drafted_at_rev"
      ]
    }
  ]
}
