{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedprakash-m.github.io/tenet/schemas/0.1/bundle.json",
  "title": "Tenet verification bundle",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "attempt",
        "workflow",
        "job",
        "index"
      ]
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "tested": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "merge-candidate",
            "head"
          ]
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commit",
        "kind",
        "head",
        "base"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inputs": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "name",
          "exit_code",
          "outcome",
          "duration_ms",
          "report",
          "report_sha256",
          "inputs"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run",
    "tested",
    "checks"
  ]
}
