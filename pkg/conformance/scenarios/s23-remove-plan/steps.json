{
  "schema": 1,
  "scenario": "s23-remove-plan",
  "spec_refs": [
    "tenet/packets/CP-0068-dogfood-fixes-0.2.0/definition.md#e--round-1-items-deferred-for-012-l-0041-now-020"
  ],
  "steps": [
    {
      "id": "01-init",
      "kind": "cli",
      "args": ["init", "--yes", "--offline", "--json"],
      "expectExitCode": 0,
      "expectedJsonMatch": "expected/01-ok.json"
    },
    {
      "id": "02-stage-init",
      "kind": "git",
      "args": ["add", "-A"]
    },
    {
      "id": "03-commit-init",
      "kind": "git",
      "args": ["commit", "-m", "Initialize tenet"]
    },
    {
      "id": "04-remove-without-tty-or-yes-fails",
      "kind": "cli",
      "args": ["remove"],
      "expectExitCodes": [1, 2],
      "expectedTextIncludes": ["remove"]
    },
    {
      "id": "05-setup-intact-after-refusal",
      "kind": "cli",
      "args": ["doctor", "--json"],
      "expectExitCode": 0,
      "expectedFilesInclude": {
        "tenet.yaml": ["standard:"],
        "AGENTS.md": ["Tenet"]
      }
    },
    {
      "id": "06-remove-with-yes",
      "kind": "cli",
      "args": ["remove", "--yes", "--json"],
      "expectExitCode": 0,
      "expectedJsonMatch": "expected/06-remove.json"
    }
  ]
}
