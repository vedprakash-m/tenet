{
  "schema": 1,
  "scenario": "s11-readme-walkthrough",
  "spec_refs": [
    "README.md#get-started",
    "tenet/specs/plan/alpha.0b.md#a0-7"
  ],
  "steps": [
    {
      "id": "01-init-yes",
      "kind": "cli",
      "args": [
        "init",
        "--yes",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/01-init.json"
    },
    {
      "id": "02-onboard-inventory",
      "kind": "cli",
      "args": [
        "onboard",
        "--inventory-only",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/02-onboard-inventory.json"
    },
    {
      "id": "03-write-agent-draft",
      "kind": "write",
      "files": {
        "tenet/intent.md": "---\ntenet: {\"spec\":1,\"doc\":\"intent\",\"level\":\"L1\",\"version\":\"0.1\",\"owner\":\"ved\"}\nsections:\n  vision: {\"state\":\"draft\",\"digest\":null,\"flags\":[]}\n  requirements: {\"state\":\"draft\",\"digest\":null,\"flags\":[]}\n---\n## Vision\n- V-1 Retry once on transient errors. {origin: documented; cites: README.md:3}\n## Requirements\n- R-1 Transient failures retry once. {origin: observed; cites: src/retry.ts:1-3; serves: V-1}\n"
      }
    },
    {
      "id": "04-fix-and-commit-draft",
      "kind": "git",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "id": "05-commit-draft",
      "kind": "git",
      "args": [
        "commit",
        "-m",
        "Draft onboarding specifications"
      ]
    },
    {
      "id": "06-onboard-card",
      "kind": "cli",
      "args": [
        "onboard",
        "--card",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/06-onboard-card.json",
      "expectedCard": "expected/06-card.md"
    },
    {
      "id": "07-bless",
      "kind": "cli",
      "args": [
        "bless",
        "--json"
      ],
      "fakeTty": [
        "1",
        "bless",
        "bless"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/07-bless.json"
    },
    {
      "id": "08-remove",
      "kind": "cli",
      "args": [
        "remove",
        "--yes",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/08-remove.json"
    }
  ]
}
