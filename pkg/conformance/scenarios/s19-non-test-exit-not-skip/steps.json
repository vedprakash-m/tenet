{
  "schema": 1,
  "scenario": "s19-non-test-exit-not-skip",
  "spec_refs": [
    "tenet/packets/CP-0068-dogfood-fixes-0.2.0/definition.md#b--checks-that-would-become-false-blocks-in-020-r2-15-r2-18-r2-09"
  ],
  "pending": "Waiting for CP-0068 Group B (restrict skip-added detection to test files)",
  "steps": [
    {
      "id": "01-init",
      "kind": "cli",
      "args": ["init", "--yes", "--offline", "--json"],
      "expectExitCode": 0,
      "expectedJsonMatch": "expected/01-ok.json"
    },
    {
      "id": "02-stage-init",
      "kind": "git",
      "args": ["add", "-A"]
    },
    {
      "id": "03-commit-init",
      "kind": "git",
      "args": ["commit", "-m", "Initialize tenet"]
    },
    {
      "id": "04-branch-non-test-exits",
      "kind": "git",
      "args": ["checkout", "-b", "feat/non-test-exits"]
    },
    {
      "id": "05-add-non-test-exits",
      "kind": "write",
      "files": {
        "scripts/helper.py": "import sys\n\ndef run():\n    sys.exit(1)\n",
        "scripts/worker.mjs": "export function work() {\n  process.exit(1);\n}\n",
        "cmd/tool/main.go": "package main\n\nimport \"os\"\n\nfunc main() {\n\tos.Exit(1)\n}\n"
      }
    },
    {
      "id": "06-stage-non-test-exits",
      "kind": "git",
      "args": ["add", "-A"]
    },
    {
      "id": "07-commit-non-test-exits",
      "kind": "git",
      "args": ["commit", "-m", "Add process exit calls in non-test files"]
    },
    {
      "id": "08-verify-non-test-exits",
      "kind": "cli",
      "args": ["verify", "--local", "--json"],
      "withoutCiEvent": true,
      "expectExitCodes": [0, 1],
      "expectedJsonMatch": "expected/07-non-test-exits.json"
    },
    {
      "id": "09-branch-real-skips",
      "kind": "git",
      "args": ["checkout", "-b", "feat/real-skips", "main"]
    },
    {
      "id": "10-add-real-skips",
      "kind": "write",
      "files": {
        "tests/test_sample.py": "import pytest\n\ndef test_one():\n    assert True\n\ndef test_two():\n    pytest.skip(\"skip python test\")\n",
        "tests/sample.test.mjs": "import test from \"node:test\";\nimport assert from \"node:assert/strict\";\n\ntest(\"one\", () => {\n  assert.equal(true, true);\n});\n\ntest.skip(\"two\", () => {\n  assert.equal(true, true);\n});\n",
        "pkg/sample/sample_test.go": "package sample\n\nimport \"testing\"\n\nfunc TestOne(t *testing.T) {}\n\nfunc TestTwo(t *testing.T) {\n\tt.Skip(\"skip go test\")\n}\n"
      }
    },
    {
      "id": "11-stage-real-skips",
      "kind": "git",
      "args": ["add", "-A"]
    },
    {
      "id": "12-commit-real-skips",
      "kind": "git",
      "args": ["commit", "-m", "Add real skips across python, javascript, and go test files"]
    },
    {
      "id": "13-verify-real-skips",
      "kind": "cli",
      "args": ["verify", "--local", "--json"],
      "withoutCiEvent": true,
      "expectExitCodes": [0, 1],
      "expectedJsonMatch": "expected/11-real-skips.json"
    }
  ]
}
