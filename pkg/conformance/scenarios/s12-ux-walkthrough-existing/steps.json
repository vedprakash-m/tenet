{
  "schema": 1,
  "scenario": "s12-ux-walkthrough-existing",
  "spec_refs": [
    "tenet/specs/ux-spec.md#1a-an-existing-repository",
    "tenet/specs/ux-spec.md#part-2-the-daily-loop",
    "tenet/specs/plan/alpha.0b.md#a0-7"
  ],
  "steps": [
    {
      "id": "01-init",
      "kind": "cli",
      "args": [
        "init",
        "--json"
      ],
      "fakeTty": [
        "Y"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/01-init.json"
    },
    {
      "id": "02-onboard-inventory",
      "kind": "cli",
      "args": [
        "onboard",
        "--inventory-only",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/02-onboard-inventory.json"
    },
    {
      "id": "03-write-agent-draft",
      "kind": "write",
      "files": {
        "tenet/intent.md": "---\ntenet: {\"spec\":1,\"doc\":\"intent\",\"level\":\"L1\",\"version\":\"0.1\",\"owner\":\"ved\"}\nsections:\n  vision: {\"state\":\"draft\",\"digest\":null,\"flags\":[]}\n  requirements: {\"state\":\"draft\",\"digest\":null,\"flags\":[]}\n  conflicts: {\"state\":\"draft\",\"digest\":null,\"flags\":[]}\n---\n## Vision\n- V-1 Reliable checkout payments. {origin: asked}\n## Requirements\n- R-1 A payment that times out is retried once, never twice. {origin: observed; cites: src/retry.ts:1-3; serves: V-1}\n## Conflicts\n- [ ] CF-1 (section: requirements) README says two retries; src/retry.ts retries once. | 1: retry once | 2: retry twice\n"
      }
    },
    {
      "id": "04-stage-draft",
      "kind": "git",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "id": "05-commit-draft",
      "kind": "git",
      "args": [
        "commit",
        "-m",
        "Draft checkout intent"
      ]
    },
    {
      "id": "06-onboard-card",
      "kind": "cli",
      "args": [
        "onboard",
        "--card",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/06-onboard-card.json",
      "expectedCard": "expected/06-card.md"
    },
    {
      "id": "07-bless",
      "kind": "cli",
      "args": [
        "bless",
        "--json"
      ],
      "fakeTty": [
        "1",
        "1",
        "no",
        "bless",
        "later"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/07-bless.json"
    },
    {
      "id": "08-board",
      "kind": "cli",
      "args": [
        "board",
        "--json"
      ],
      "expectExitCode": 0,
      "expectedJson": "expected/08-board.json"
    }
  ]
}
